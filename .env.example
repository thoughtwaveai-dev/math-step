# MathStep — example environment variables.
# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase (client + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — server-only.
# Used exclusively by the daily-reminder cron route handler and the
# email unsubscribe route to bypass RLS for cross-parent reads/writes.
# Never imported from client components or middleware.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (Daily Reminder Email v1)
RESEND_API_KEY=

# REMINDER_FROM_EMAIL must be set per environment.
#   Local dev — only delivers to the Resend account owner's verified inbox:
#     REMINDER_FROM_EMAIL=onboarding@resend.dev
#   Production — REQUIRES a verified domain in Resend:
#     REMINDER_FROM_EMAIL="MathStep <reminders@yourdomain>"
REMINDER_FROM_EMAIL=

# Cron auth: any cryptographically-random hex string (e.g. `openssl rand -hex 32`).
# Vercel Cron sends it as the `Authorization: Bearer <CRON_SECRET>` header.
CRON_SECRET=

# HMAC secret for one-tap email unsubscribe links.
# Independent from CRON_SECRET — `openssl rand -hex 32` again.
REMINDER_UNSUB_SECRET=

# Public origin used to build absolute links in emails (CTA + unsubscribe).
# Local dev: http://localhost:3000
# Production: https://your-vercel-domain
NEXT_PUBLIC_APP_URL=http://localhost:3000
